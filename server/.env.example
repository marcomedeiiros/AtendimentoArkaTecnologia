# Copie para .env e preencha os segredos.
# Gere chaves fortes com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=http://localhost:5173

# api do zap
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
WHATSAPP_INSTANCE=arka-wapi-oficial
WEBHOOK_SECRET=

# user administrador inicial
ADMIN_EMAIL=admin@arkatecnologia.com.br
ADMIN_PASSWORD=
ADMIN_NOME=Administrador Arka
