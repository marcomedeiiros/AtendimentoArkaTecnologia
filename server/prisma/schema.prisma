generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTA: SQLite (via Prisma) nao suporta enums nativos.
// Os campos abaixo eram enums no Postgres e viraram String.
// Valores validos permanecem controlados pelos DTOs (zod) da aplicacao:
//   StatusAtendimento: pendente | aberta | fechada
//     (legado, migrado via backfill: aguardando->pendente, em_atendimento->aberta,
//      finalizado/resolvido->fechada)
//   OrigemMensagem:    cliente | equipe | sistema | bot
//   StatusParceiro:    ativo | inativo
//   StatusEquipe:      online | offline
//   TipoPassoFluxo:    gatilho | mensagem | condicao | delay | acao | comentario
//   TagContato:        cliente | parceiro | suporte | vip | inativo

model Instancia {
  id            String   @id @default(uuid())
  nome          String   @unique
  conectado     Boolean  @default(false)
  webhookSecret String   @map("webhook_secret")
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  conversas     Conversa[]
  sessoes       SessaoChatbot[]
  logsExecucao  LogExecucaoFluxo[]

  @@map("instancias")
}

// Configuracoes editaveis pela tela (Evolution API, n8n). Sobrepoem o .env:
// quem le usa o valor do banco e, se nao existir, cai no env.
model Configuracao {
  chave        String   @id
  valor        String
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("configuracoes")
}

// Preferencias de interface por operador (filtros da Central, etc). Guardadas
// como JSON serializado para nao exigir migracao a cada nova preferencia.
model Preferencia {
  id           String   @id @default(uuid())
  usuarioId    String   @map("usuario_id")
  chave        String
  valor        String
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([usuarioId, chave])
  @@map("preferencias")
}

model Usuario {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash    String   @map("senha_hash")
  cargo        String   @default("Administrador")
  ativo        Boolean  @default(true)
  // Ultima requisicao autenticada desta pessoa. E o que sustenta o "online" da
  // Gestao da Equipe: com o painel aberto, o front consulta o servidor a cada
  // poucos segundos, entao presenca recente aqui significa aba aberta agora.
  ultimoAcessoEm DateTime? @map("ultimo_acesso_em")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  conversasAtendidas Conversa[] @relation("AtendenteConversa")

  @@map("usuarios")
}

// NAO existe mais um model Equipe aqui.
//
// Ele era uma lista paralela, digitada a mao, sem ligacao nenhuma com quem
// realmente usa o sistema: `Conversa.atendenteId` sempre apontou para Usuario,
// nunca para Equipe. Entao "adicionar atendente" criava um nome que nao podia
// atender nada, e o status online/offline era um botao que a propria pessoa
// virava. A equipe agora sai de Usuario -- quem tem conta e quem esta na lista.

model Parceiro {
  cnpj         String         @id
  razaoSocial  String         @map("razao_social")
  status       String         @default("ativo")
  criadoEm     DateTime       @default(now()) @map("criado_em")
  atualizadoEm DateTime       @updatedAt @map("atualizado_em")

  conversas Conversa[]

  @@index([status])
  @@map("parceiros")
}

model Contato {
  id           String     @id @default(uuid())
  nome         String
  telefone     String
  email        String?
  empresa      String?
  tag          String     @default("cliente")
  favorito     Boolean    @default(false)
  observacoes  String?
  criadoEm     DateTime   @default(now()) @map("criado_em")
  atualizadoEm DateTime   @updatedAt @map("atualizado_em")

  @@index([telefone])
  @@index([tag])
  @@map("contatos")
}

model Fluxo {
  id           String   @id @default(uuid())
  nome         String
  gatilho      String
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  passos       PassoFluxo[]
  sessoes      SessaoChatbot[]
  logsExecucao LogExecucaoFluxo[]

  @@index([gatilho, ativo])
  @@map("fluxos")
}

model PassoFluxo {
  id           String         @id @default(uuid())
  fluxoId      String         @map("fluxo_id")
  tipo         String
  titulo       String
  descricao    String?        @map("descricao")
  texto        String?
  config       Json?
  posX         Float?         @map("pos_x")
  posY         Float?         @map("pos_y")
  largura      Float?         @map("largura")
  altura       Float?         @map("altura")
  targetId     String?        @map("target_id")
  ordem        Int            @default(0)
  criadoEm     DateTime       @default(now()) @map("criado_em")
  atualizadoEm DateTime       @updatedAt @map("atualizado_em")

  fluxo Fluxo @relation(fields: [fluxoId], references: [id], onDelete: Cascade)

  @@index([fluxoId, ordem])
  @@map("fluxo_passos")
}

model Conversa {
  id                String            @id @default(uuid())
  instanciaId       String            @map("instancia_id")
  cliente           String
  telefone          String
  statusAtendimento String            @default("pendente") @map("status_atendimento")
  cnpj              String?
  cnpjVerificado    Boolean           @default(false) @map("cnpj_verificado")
  lido              Boolean           @default(false)
  naoLidas          Int               @default(0) @map("nao_lidas")
  fotoUrl           String?           @map("foto_url")
  // Flags de organizacao da lista. Arquivar/ocultar NAO apagam nada: apenas
  // tiram a conversa da listagem padrao (controlado pelos filtros da tela).
  favorita          Boolean           @default(false)
  fixada            Boolean           @default(false)
  arquivada         Boolean           @default(false)
  oculta            Boolean           @default(false)
  atendenteId       String?           @map("atendente_id")
  atendidoEm        DateTime?         @map("atendido_em")
  fechadoEm         DateTime?         @map("fechado_em")
  criadoEm          DateTime          @default(now()) @map("criado_em")
  atualizadoEm      DateTime          @updatedAt @map("atualizado_em")

  instancia   Instancia  @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  atendente   Usuario?   @relation("AtendenteConversa", fields: [atendenteId], references: [id], onDelete: SetNull)
  parceiroRef Parceiro?  @relation(fields: [cnpj], references: [cnpj], onDelete: SetNull)
  mensagens   Mensagem[]
  sessao      SessaoChatbot?

  @@index([telefone])
  @@index([statusAtendimento])
  @@index([instanciaId, telefone])
  @@map("conversas")
}

model Mensagem {
  id         String         @id @default(uuid())
  conversaId String         @map("conversa_id")
  origem     String
  texto      String
  metadata   Json?
  // Id da mensagem na Evolution API. A unicidade e o que impede o mesmo
  // webhook reentregue de rodar o fluxo duas vezes.
  waMessageId String?       @unique @map("wa_message_id")
  // Ciclo de vida da mensagem que NOS enviamos, alimentado pelo evento
  // messages.update da Evolution: enviando | enviada | entregue | lida | erro.
  // Null nas mensagens recebidas do cliente (nao ha o que confirmar).
  status         String?
  // Mensagem citada (recurso "responder" do WhatsApp).
  respondendoAId String?    @map("respondendo_a_id")
  editadaEm      DateTime?  @map("editada_em")
  criadoEm   DateTime       @default(now()) @map("criado_em")

  conversa Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId, criadoEm])
  @@map("mensagens")
}

model SessaoChatbot {
  id           String   @id @default(uuid())
  instanciaId  String   @map("instancia_id")
  conversaId   String   @unique @map("conversa_id")
  telefone     String
  fluxoAtualId String?  @map("fluxo_atual_id")
  passoAtualId String?  @map("passo_atual_id")
  contexto     Json?
  aguardando   String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  instancia  Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  conversa   Conversa  @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  fluxoAtual Fluxo?    @relation(fields: [fluxoAtualId], references: [id], onDelete: SetNull)

  @@unique([instanciaId, telefone])
  @@index([telefone])
  @@map("sessoes_chatbot")
}

model LogExecucaoFluxo {
  id          String   @id @default(uuid())
  instanciaId String   @map("instancia_id")
  fluxoId     String   @map("fluxo_id")
  conversaId  String?  @map("conversa_id")
  passoId     String?  @map("passo_id")
  tipo        String
  titulo      String
  mensagem    String?
  sucesso     Boolean  @default(true)
  duracaoMs   Int?     @map("duracao_ms")
  criadoEm    DateTime @default(now()) @map("criado_em")

  instancia Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  fluxo     Fluxo     @relation(fields: [fluxoId], references: [id], onDelete: Cascade)

  @@index([fluxoId, criadoEm])
  @@map("logs_execucao_fluxo")
}
