# Dependencias
node_modules/

# Build
client/dist/

# Segredos e variaveis de ambiente
.env
.env.*
!.env.example

# Backups gerados ao mexer em schema/configuracao
*.bak-*
server/prisma/*.db.bak-*

# Banco local de desenvolvimento
server/prisma/dev.db
server/prisma/dev.db-journal

# Backups do banco gerados na VM (deploy/backup.sh)
backups/

# Logs
*.log
npm-debug.log*
server/prisma/dev.db-shm
server/prisma/dev.db-wal

# Copias do banco de desenvolvimento salvas antes de um reparo. Sao arquivos
# grandes e locais -- e um deles esta corrompido de proposito, guardado so como
# ponto de retorno.
server/prisma/dev.db.corrompido-*
server/prisma/dev.db.bak-*
