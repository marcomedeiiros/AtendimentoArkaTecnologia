# Configuracao da stack na VM. Copie para .env (que nunca vai para o git):
#
#   cp .env.example .env
#
# O deploy/instalar.sh cria esse arquivo sozinho e ja sorteia os segredos.
# Preencha a mao apenas se estiver fazendo a instalacao manual.
#
# Gere cada segredo com:
#   openssl rand -hex 24


# ---------------------------------------------------------------------------
# Rede
# ---------------------------------------------------------------------------
# IP da VM na rede interna. E por ele que a equipe abre o painel.
VM_IP=192.168.0.10

# Porta do painel na VM. 80 = http://IP_DA_VM direto, sem porta na URL.
WEB_PORT=80

# Origem aceita pelo CORS. Painel e API ficam na mesma origem (o nginx faz o
# proxy do /api), entao isso quase nao entra em acao -- mas deve bater com a
# URL que a equipe digita no navegador. Com WEB_PORT diferente de 80, inclua a
# porta aqui: http://192.168.0.10:8090
CORS_ORIGIN=http://192.168.0.10


# ---------------------------------------------------------------------------
# Segredos  (TROQUE TODOS -- os valores do server/.env.example sao publicos no
# GitHub e nao servem para producao)
# ---------------------------------------------------------------------------
# Assina os tokens de sessao do painel.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Autentica o Arka na Evolution. O compose usa a mesma chave nos dois lados.
EVOLUTION_API_KEY=

# Protege o webhook que recebe as mensagens do WhatsApp.
WEBHOOK_SECRET=

# Senha do Postgres interno da Evolution.
EVOLUTION_DB_PASSWORD=


# ---------------------------------------------------------------------------
# Instancia do WhatsApp
# ---------------------------------------------------------------------------
WHATSAPP_INSTANCE=arka-wapi-oficial


# ---------------------------------------------------------------------------
# Administrador inicial
# ---------------------------------------------------------------------------
# Este usuario e criado no primeiro boot. ATENCAO: o seed ressincroniza a senha
# a cada subida do container -- trocar a senha aqui troca a senha de verdade, e
# uma troca feita pelo painel seria desfeita no proximo restart.
ADMIN_EMAIL=admin@arkatecnologia.com.br
ADMIN_PASSWORD=
ADMIN_NOME=Administrador Arka


# ---------------------------------------------------------------------------
# Cadastro de novos usuarios
# ---------------------------------------------------------------------------
# VAZIO = cadastro aberto: qualquer pessoa que alcance a URL cria conta e passa
# a ler as conversas dos clientes. Na VM, preencha com um codigo e passe so
# para a equipe -- o campo aparece sozinho na tela de cadastro.
REGISTRO_CODIGO=
